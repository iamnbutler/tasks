# Required
GITHUB_TOKEN=ghp_your_token_here
TASKS_PROJECTS=owner/repo,owner/other-repo

# Required for agent sessions
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional — defaults shown
TASKS_MAX_SESSIONS=5
TASKS_POLL_INTERVAL=60
TASKS_DISPATCH_INTERVAL=30
TASKS_CONTAINER_IMAGE=tasks-agent:latest
TASKS_EVENT_DIR=/tmp/tasks-events
