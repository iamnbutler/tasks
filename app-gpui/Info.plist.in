<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the Tasks.app bundle's Info.plist. `make app` renders it with
  sed, substituting @VERSION@ and @COMMIT@. The bundle identifier and the
  deployment target carry over from the retired Swift target, so installing
  replaces the old app in place.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Tasks</string>
	<key>CFBundleIdentifier</key>
	<string>com.iamnbutler.tasks</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Tasks</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@COMMIT@</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (c) 2026 Nate Butler. Tasks is MIT licensed; this bundle also contains Apache-2.0 components — see Contents/Resources/third-party/NOTICES.md.</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
