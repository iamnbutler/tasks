node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example

# Rust
target/
Cargo.lock
# ...except app-gpui's: it is not a workspace member, so it resolves its own
# dependency graph and ships as an app, which wants a reproducible one. The
# negation is load-bearing — `git add -f` would commit the file once and then
# hide every later regeneration from `git status`.
!/app-gpui/Cargo.lock
.claude/worktrees/
.worktrees/

# Xcode
xcuserdata/
DerivedData/

# Image build staging (Makefile copies these in and removes them after
# `container build`; a concurrent `git add -A` must never catch one)
images/base/supervisor
images/scout/scout-supervisor
images/builder/builder-supervisor

# local scratch dumps of the API (curl output)
/.*.json
